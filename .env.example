# v1 API + legacy (SQLite — pa XAMPP)
ENV=development
SECRET_KEY=change-me-in-production-min-16-chars

# Fjalëkalimi i llogarisë fillestare "admin".
# Përdoret VETËM kur admini nuk ekziston ende; nuk rivendos kurrë një admin ekzistues.
# I detyrueshëm kur ENV=production (minimumi 12 karaktere) — përndryshe startup-i dështon.
ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./data/plagiarism_checker.db
JWT_SECRET=change-me-in-production-min-16-chars

# Legacy dashboards (SQLite; MySQL/XAMPP nuk nevojitet)
LEGACY_DATABASE_URL=sqlite:///./data/plagiarism_checker.db
LEGACY_ALLOW_SQLITE_FALLBACK=1
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=plagiarism_checker

# URL publike e aplikacionit (për lidhjet e rivendosjes së fjalëkalimit)
APP_PUBLIC_URL=http://127.0.0.1:8000

# Email (SMTP) — rivendosje fjalëkalimi
# Pa SMTP, lidhja shkruhet në logs/password_reset.log (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@universitetiaab.com
SMTP_USE_TLS=1
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_DEV_LOG=1

# --- Kërkim Web për Plagjiaturë (mjafton NJË çelës) ---
# Rekomandohet Serper (Google Search, falas): https://serper.dev/
SERPER_API_KEY=

# Brave Search API — https://brave.com/search/api/ (2000 kërkime/muaj falas)
BRAVE_SEARCH_API_KEY=

# SerpAPI — https://serpapi.com/ (100 kërkime falas/muaj)
SERPAPI_KEY=

# Tavily — https://tavily.com/ (1000 kërkime/muaj falas)
TAVILY_API_KEY=

# Bing Search v7 (Azure) — https://portal.azure.com/
BING_SEARCH_API_KEY=

# Google Custom Search — https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Kërkohet Search API për kërkim web (jo DuckDuckGo)
WEB_SEARCH_REQUIRE_API=1

# SearXNG (vetëm nëse WEB_SEARCH_ALLOW_FALLBACK=1)
SEARXNG_URL=https://searx.be

# Analiza ML — vendos DISABLE_ML_MODELS=1 vetëm nëse serveri crash-on (memorie e ulët)
# DISABLE_ML_MODELS=0

# Model më i fortë për parafrazim (opsional, më shumë RAM):
# PLAGIARISM_BI_ENCODER=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# FAISS prefilter për korpuse të mëdha
FAISS_PREFILTER_THRESHOLD=20
FAISS_TOP_K=40

# Burime akademike (OpenAlex, Crossref, Semantic Scholar) — aktivë pa çelës
ACADEMIC_SEARCH=1
# OPENALEX_EMAIL=you@example.com
# CROSSREF_MAILTO=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=

# Ruajtje cloud (local | s3) — MinIO / AWS S3
STORAGE_BACKEND=local
# S3_BUCKET=plagiarism
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_PREFIX=plagiarism/